# Zorevi Environment Variables
# Copy this file to .env and fill in the values

# API base URL. Use /api with the local Vite proxy (Spring backend on port 8080).
VITE_API_BASE_URL=/api

# App Name
VITE_APP_NAME=Zorevi

# Note: Do NOT put secrets, private keys, or payment credentials here.
# Frontend environment variables are visible to users in the browser.
